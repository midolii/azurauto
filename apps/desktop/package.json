{
  "name": "desktop",
  "version": "0.1.0",
  "description": "AzurAuto desktop app",
  "author": "midolii",
  "private": true,
  "type": "module",
  "main": "electron/main.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev:web": "vite dev --port 3000",
    "dev:electron:only": "electron ./electron/main.ts",
    "dev:electron": "node ./scripts/dev-electron.mjs",
    "dev": "pnpm build:deps && pnpm build:preload && pnpm dev:electron",
    "clean:build-output": "node ./scripts/clean-build-output.mjs",
    "build:web": "pnpm clean:build-output && vite build",
    "build:deps": "pnpm --filter @azurauto/adb build && pnpm --filter @azurauto/automation build",
    "build:preload": "node ./scripts/build-preload.mjs",
    "fetch:scrcpy-server": "pnpm --filter @azurauto/adb fetch:scrcpy-server",
    "prepare:android-resources": "pnpm fetch:scrcpy-server && node ./scripts/prepare-android-resources.mjs",
    "build": "pnpm build:preload && pnpm build:web",
    "build:app": "pnpm build:deps && pnpm prepare:android-resources && pnpm build:preload && pnpm build:web && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@azurauto/adb": "workspace:*",
    "@azurauto/automation": "workspace:*",
    "@faker-js/faker": "^10.4.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "^1.168.14",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nitro": "npm:nitro-nightly@3.0.260603-beta",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "extract-zip": "^2.0.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.azurauto.desktop",
    "productName": "AzurAuto",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": ".output"
      },
      {
        "from": "resources/android",
        "to": "android"
      }
    ],
    "mac": {
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
